{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "home-dashboard",
	"compatibility_date": "2026-09-30",
	"main": "worker.js",
	"assets": {
		"directory": "./dist",
		// The Worker runs before every asset so its access gate covers the page too (see worker.js)
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"vars": {
		// Weather: latitude + longitude for Open-Meteo (free, no API key needed)
		"WEATHER_LAT": "52.52",
		"WEATHER_LON": "13.41",
		// IANA timezone name — Open-Meteo aligns hourly array to local midnight
		"WEATHER_TZ": "Europe/Berlin",
		// BVG stop ID (find via https://v6.bvg.transport.rest/locations?query=StopName)
		"BVG_STOP_ID": "900110001",
		// Display name shown in the transit widget
		"BVG_STOP_NAME": "S+U Schönhauser Allee",
		// Minutes to walk to the stop; departures leaving sooner are hidden
		"BVG_WALK_MIN": "10",
		// Views the frame shows (rail order). Valid: home, calendar, tasks, shopping, fridge, meals, kitchen, photos.
		// "home" is always on. Unknown names are ignored. Change + redeploy; the frame picks it up within ~5 min.
		"VIEWS": "home,calendar,tasks,shopping,fridge,meals,kitchen,photos",
		// Unsplash search term for the photo stream; remove for the editorial feed. Secret: UNSPLASH_KEY
		"PHOTO_QUERY": "aesthetic wallpapers",
		// Cookidoo country domain and language (week plan, cookidoo.js)
		"COOKIDOO_HOST": "cookidoo.de",
		"COOKIDOO_LANG": "de-DE"
	},
	// Cookidoo token store. Wrangler creates the namespace on first deploy; seed the refresh token (SETUP.md).
	"kv_namespaces": [
		{
			"binding": "COOKIDOO_KV",
			"id": "583f4c6324bc464e8ea6e9519d2fa930"
		},
		{
			// REWE fridge feed (rewe:latest, rewe:used), PLAN-rewe-fridge.md step 3.2. No id yet: paste it here
			// after `npx wrangler kv namespace create FRIDGE_KV`, or wrangler provisions one on deploy.
			"binding": "FRIDGE_KV",
			"id": "3fa67ec9a51d4afebc5fa5a2ac9ca9a7"
		}
	]
	// Secrets — set via: wrangler secret put SECRET_NAME
	// Required: GOOGLE_SERVICE_EMAIL, GOOGLE_SERVICE_KEY (PEM private key from service account JSON)
	// Required: CAL_ALEX (Fauzan), CAL_JORDAN (Amanda)  (Google Calendar IDs, e.g. user@gmail.com)
	// Required: BRING_EMAIL, BRING_PASSWORD
	// Required: DASH_TOKEN (same value as VITE_DASH_TOKEN in dashboard/.env at build time). Gates the whole
	//   site and the writes; open /?key=<DASH_TOKEN> once on each device to set the access cookie.
	// Required for the Fridge feed: INGEST_KEY (bearer the REWE job sends to POST /api/ingest, PLAN-rewe-fridge.md)
	// Optional: BRING_LIST var (default "home")
	// Optional: TICKTICK_TOKEN (Chores view, see SETUP.md), TICKTICK_PROJECT var (default "Chores")
}
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Pexels search term; remove for the curated feed. Key: `wrangler secret put PEXELS_KEY`
    "PHOTO_QUERY": "nature landscape"
  }
}
